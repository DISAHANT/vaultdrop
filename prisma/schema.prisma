generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ShareStatus {
  ACTIVE
  EXPIRED
  REVOKED
  DELETED
}

enum WorkspaceStatus {
  CREATING
  VERIFYING
  PACKAGING
  UPLOADING_PACKAGE
  READY
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String?  @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shares         Share[]
  syncSessions   SyncSession[]
  devices        UserDevice[]
  workspaces     Workspace[]
  clipboardItems ClipboardItem[]
  sentTransfers  DeviceTransfer[] @relation("SentTransfers")
  sentWorkspaceShares     WorkspaceShare[] @relation("SentWorkspaceShares")
  receivedWorkspaceShares WorkspaceShare[] @relation("ReceivedWorkspaceShares")
  githubConnections       GitHubConnection[]
  githubOperations        GitHubOperation[]
  sentNotifications       Notification[] @relation("SentNotifications")
  receivedNotifications   Notification[] @relation("ReceivedNotifications")

  @@map("users")
}

model UserDevice {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  deviceId    String    @map("device_id") @db.VarChar(100)
  deviceName  String    @map("device_name") @db.VarChar(100)
  deviceType  String    @default("laptop") @map("device_type") @db.VarChar(50) // 'laptop' | 'desktop' | 'mobile' | 'tablet'
  browser     String?   @db.VarChar(50)
  os          String?   @db.VarChar(50)
  isOnline    Boolean   @default(true) @map("is_online")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  lastSyncAt  DateTime? @map("last_sync_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([deviceId])
  @@index([userId])
  @@index([lastSeenAt])
  @@map("user_devices")
}

model DeviceTransfer {
  id               String   @id @default(cuid())
  senderUserId     String   @map("sender_user_id")
  senderDeviceId   String   @map("sender_device_id") @db.VarChar(100)
  senderDeviceName String   @map("sender_device_name") @db.VarChar(100)
  targetDeviceId   String   @map("target_device_id") @db.VarChar(100)
  targetDeviceName String?  @map("target_device_name") @db.VarChar(100)
  title            String   @db.VarChar(255)
  type             String   @default("file") @db.VarChar(50) // 'file' | 'clipboard' | 'workspace' | 'text' | 'image'
  content          String?  @db.LongText
  fileKey          String?  @map("file_key") @db.VarChar(500)
  fileName         String?  @map("file_name") @db.VarChar(500)
  fileSize         BigInt?  @map("file_size")
  mimeType         String?  @map("mime_type") @db.VarChar(255)
  status           String   @default("pending") @db.VarChar(30) // 'pending' | 'accepted' | 'declined' | 'completed'
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  sender User @relation("SentTransfers", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([targetDeviceId])
  @@index([senderUserId])
  @@index([status])
  @@index([createdAt])
  @@map("device_transfers")
}

model Workspace {
  id                String          @id @default(cuid())
  ownerId           String?         @map("owner_id")
  uploadSessionId   String?         @unique @map("upload_session_id") @db.VarChar(100)
  shareCode         String          @unique @map("share_code") @db.VarChar(20)
  name              String          @db.VarChar(255)
  description       String?         @db.Text
  framework         String?         @db.VarChar(50)
  language          String?         @db.VarChar(50)
  packageManager    String?         @map("package_manager") @db.VarChar(50)
  totalFiles        Int             @default(0) @map("total_files")
  totalSize         BigInt          @default(0) @map("total_size")
  excludedCount     Int             @default(0) @map("excluded_count")
  sensitiveCount    Int             @default(0) @map("sensitive_count")
  healthSummary     String?         @map("health_summary") @db.LongText
  skippedSummary    String?         @map("skipped_summary") @db.LongText
  packageKey        String?         @map("package_key") @db.VarChar(500)
  manifestKey       String?         @map("manifest_key") @db.VarChar(500)
  packageChecksum   String?         @map("package_checksum") @db.VarChar(64)
  packageSize       BigInt?         @map("package_size")
  verifiedFileCount Int?            @map("verified_file_count")
  workspaceStatus   WorkspaceStatus @default(CREATING) @map("workspace_status")
  status            ShareStatus     @default(ACTIVE)
  expiresAt         DateTime?       @map("expires_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  owner       User?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  files       WorkspaceFile[]
  snapshots   WorkspaceSnapshot[]
  shares      WorkspaceShare[]
  githubRepos WorkspaceGitHubRepo[]

  @@index([ownerId])
  @@index([status])
  @@index([workspaceStatus])
  @@index([createdAt])
  @@map("workspaces")
}

model WorkspaceShare {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  senderId        String    @map("sender_id")
  recipientEmail  String    @map("recipient_email") @db.VarChar(255)
  recipientId     String?   @map("recipient_id")
  permission      String    @default("download") @db.VarChar(50)
  message         String?   @db.VarChar(500)
  status          String    @default("sent") @db.VarChar(50) // 'sent' | 'pending' | 'received' | 'downloaded' | 'revoked' | 'expired'
  downloadCount   Int       @default(0) @map("download_count")
  downloadedAt    DateTime? @map("downloaded_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sender    User      @relation("SentWorkspaceShares", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User?     @relation("ReceivedWorkspaceShares", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([recipientEmail])
  @@index([recipientId])
  @@index([senderId])
  @@index([status])
  @@map("workspace_shares")
}

model WorkspaceFile {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  relativePath    String   @map("relative_path") @db.VarChar(1000)
  filename        String   @db.VarChar(255)
  fileSize        BigInt   @map("file_size")
  mimeType        String   @map("mime_type") @db.VarChar(100)
  fileKey         String?  @map("file_key") @db.VarChar(500)
  checksum        String?  @db.VarChar(64)
  category        String   @default("code") @db.VarChar(50)
  isSensitive     Boolean  @default(false) @map("is_sensitive")
  uploadVerified  Boolean  @default(false) @map("upload_verified")
  createdAt       DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([category])
  @@index([fileKey])
  @@map("workspace_files")
}

model Notification {
  id          String    @id @default(cuid())
  recipientId String    @map("recipient_id")
  senderId    String?   @map("sender_id")
  type        String    @db.VarChar(50) // 'workspace_shared' | 'workspace_downloaded' | 'share_revoked' | 'system'
  title       String    @db.VarChar(255)
  message     String    @db.Text
  workspaceId String?   @map("workspace_id")
  shareId     String?   @map("share_id")
  metadata    String?   @db.Text // JSON with additional data
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  recipient User  @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  sender    User? @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([recipientId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model WorkspaceSnapshot {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  snapshotNumber Int      @default(1) @map("snapshot_number")
  name           String   @db.VarChar(100)
  description    String?  @db.VarChar(500)
  totalFiles     Int      @map("total_files")
  totalSize      BigInt   @map("total_size")
  archiveKey     String?  @map("archive_key") @db.VarChar(500)
  metadata       String?  @db.LongText // JSON file manifest snapshot
  createdAt      DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([createdAt])
  @@map("workspace_snapshots")
}

model ClipboardItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  deviceId  String?  @map("device_id") @db.VarChar(100)
  type      String   @default("text") @db.VarChar(30) // 'text' | 'url' | 'code' | 'image'
  content   String   @db.LongText
  preview   String?  @db.VarChar(255)
  category  String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("clipboard_items")
}

model Share {
  id            String      @id @default(cuid())
  ownerId       String?     @map("owner_id")
  shareCode     String      @unique @map("share_code") @db.VarChar(20)
  title         String?     @db.VarChar(255)
  description   String?     @db.Text
  passwordHash  String?     @map("password_hash")
  expiresAt     DateTime?   @map("expires_at")
  maxDownloads  Int?        @map("max_downloads")
  downloadCount Int         @default(0) @map("download_count")
  totalFiles    Int         @default(0) @map("total_files")
  totalSize     BigInt      @default(0) @map("total_size")
  status        ShareStatus @default(ACTIVE)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  owner          User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  files          File[]
  downloadEvents DownloadEvent[]

  @@index([ownerId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("shares")
}

model File {
  id               String   @id @default(cuid())
  shareId          String   @map("share_id")
  originalFilename String   @map("original_filename") @db.VarChar(500)
  mimeType         String   @map("mime_type") @db.VarChar(255)
  fileSize         BigInt   @map("file_size")
  fileData         Bytes?   @map("file_data") @db.LongBlob
  fileKey          String?  @map("file_key") @db.VarChar(500)
  checksum         String?  @db.VarChar(64)
  createdAt        DateTime @default(now()) @map("created_at")

  share          Share           @relation(fields: [shareId], references: [id], onDelete: Cascade)
  downloadEvents DownloadEvent[]

  @@index([shareId])
  @@index([fileKey])
  @@map("files")
}

model DownloadEvent {
  id           String   @id @default(cuid())
  shareId      String   @map("share_id")
  fileId       String?  @map("file_id")
  ipHash       String?  @map("ip_hash") @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  downloadedAt DateTime @default(now()) @map("downloaded_at")

  share Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)
  file  File?  @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([shareId])
  @@index([fileId])
  @@index([downloadedAt])
  @@map("download_events")
}

enum SessionType {
  TEMPORARY
  PERMANENT
}

enum SyncStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model SyncSession {
  id           String      @id @default(cuid())
  code         String      @unique @map("code") @db.VarChar(20)
  title        String?     @db.VarChar(255)
  type         SessionType @default(TEMPORARY)
  status       SyncStatus  @default(ACTIVE)
  ownerId      String?     @map("owner_id")
  expiresAt    DateTime?   @map("expires_at")
  lastActiveAt DateTime    @default(now()) @map("last_active_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  owner        User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  clips        SyncClip[]
  devices      SyncDevice[]

  @@index([ownerId])
  @@index([status])
  @@index([expiresAt])
  @@map("sync_sessions")
}

model SyncClip {
  id          String      @id @default(cuid())
  sessionId   String      @map("session_id")
  senderId    String      @map("sender_id") @db.VarChar(100)
  senderName  String      @map("sender_name") @db.VarChar(100)
  type        String      @default("text") @db.VarChar(20) // 'text' | 'url' | 'image'
  content     String      @db.LongText
  createdAt   DateTime    @default(now()) @map("created_at")

  session     SyncSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("sync_clips")
}

model SyncDevice {
  id          String      @id @default(cuid())
  sessionId   String      @map("session_id")
  deviceId    String      @map("device_id") @db.VarChar(100)
  deviceName  String      @map("device_name") @db.VarChar(100)
  isOnline    Boolean     @default(true) @map("is_online")
  lastSeenAt  DateTime    @default(now()) @map("last_seen_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  session     SyncSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, deviceId])
  @@index([sessionId])
  @@map("sync_devices")
}

model UploadChunk {
  id         String   @id @default(cuid())
  uploadId   String   @map("upload_id") @db.VarChar(100)
  fileIndex  Int      @map("file_index")
  chunkIndex Int      @map("chunk_index")
  chunkData  Bytes    @map("chunk_data") @db.LongBlob
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([uploadId, fileIndex, chunkIndex])
  @@index([uploadId])
  @@map("upload_chunks")
}

// ─── GitHub Integration Models ───

model GitHubConnection {
  id                   String   @id @default(cuid())
  vaultdropUserId      String   @map("vaultdrop_user_id")
  githubUserId         Int      @map("github_user_id")
  githubLogin          String   @map("github_login") @db.VarChar(100)
  githubAvatarUrl      String?  @map("github_avatar_url") @db.VarChar(500)
  githubInstallationId Int?     @map("github_installation_id")
  githubAccountType    String   @default("User") @map("github_account_type") @db.VarChar(30)
  accessToken          String?  @map("access_token") @db.Text
  status               String   @default("active") @db.VarChar(30) // 'active' | 'revoked' | 'expired'
  connectedAt          DateTime @default(now()) @map("connected_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [vaultdropUserId], references: [id], onDelete: Cascade)

  @@unique([vaultdropUserId, githubUserId])
  @@index([vaultdropUserId])
  @@index([githubUserId])
  @@index([githubInstallationId])
  @@map("github_connections")
}

model WorkspaceGitHubRepo {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  vaultdropUserId String   @map("vaultdrop_user_id")
  installationId  Int      @map("installation_id")
  repositoryId    Int      @map("repository_id")
  owner           String   @db.VarChar(100)
  repositoryName  String   @map("repository_name") @db.VarChar(200)
  defaultBranch   String   @default("main") @map("default_branch") @db.VarChar(100)
  lastCommitSha   String?  @map("last_commit_sha") @db.VarChar(64)
  lastSyncAt      DateTime? @map("last_sync_at")
  connectedAt     DateTime @default(now()) @map("connected_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, repositoryId])
  @@index([workspaceId])
  @@index([vaultdropUserId])
  @@index([repositoryId])
  @@map("workspace_github_repos")
}

model GitHubWebhookEvent {
  id          String   @id @default(cuid())
  deliveryId  String   @unique @map("delivery_id") @db.VarChar(100)
  eventType   String   @map("event_type") @db.VarChar(50)
  action      String?  @db.VarChar(50)
  repositoryId Int?    @map("repository_id")
  status      String   @default("received") @db.VarChar(30) // 'received' | 'processed' | 'ignored' | 'failed'
  payloadHash String?  @map("payload_hash") @db.VarChar(64)
  errorMessage String? @map("error_message") @db.Text
  receivedAt  DateTime @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@index([eventType])
  @@index([repositoryId])
  @@index([receivedAt])
  @@map("github_webhook_events")
}

model GitHubOperation {
  id              String    @id @default(cuid())
  vaultdropUserId String    @map("vaultdrop_user_id")
  workspaceId     String?   @map("workspace_id")
  repositoryId    Int?      @map("repository_id")
  repositoryName  String?   @map("repository_name") @db.VarChar(200)
  operation       String    @db.VarChar(30) // CONNECT, INSTALL, LIST_REPOSITORIES, ANALYZE, COMMIT, PULL, WEBHOOK, SYNC, DISCONNECT
  status          String    @default("started") @db.VarChar(30) // 'started' | 'success' | 'failed' | 'cancelled'
  commitSha       String?   @map("commit_sha") @db.VarChar(64)
  filesChanged    Int?      @map("files_changed")
  errorCode       String?   @map("error_code") @db.VarChar(20)
  errorMessage    String?   @map("error_message") @db.Text
  metadata        String?   @db.LongText // safe JSON metadata (no secrets)
  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")

  user User @relation(fields: [vaultdropUserId], references: [id], onDelete: Cascade)

  @@index([vaultdropUserId])
  @@index([workspaceId])
  @@index([operation])
  @@index([startedAt])
  @@map("github_operations")
}
